# gre-panel:managed=1 interface=gre-b-2
# This file is generated by gre-panel. Edit the tunnel in the panel; changes made
# here are overwritten the next time it is applied.

[Unit]
Description=GRE Tunnel gre-b-2 (managed by gre-panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/sbin/modprobe ip_gre
ExecStartPre=-/sbin/ip link del gre-b-2
ExecStart=/sbin/ip link add name gre-b-2 type gre local 203.0.113.10 remote 198.51.100.20 ttl 255 tos 0x10 ikey 2749365187 okey 2749365187 icsum ocsum iseq oseq pmtudisc dev eth0
ExecStart=/sbin/ip addr add 172.17.2.2/30 dev gre-b-2
ExecStart=/sbin/ip addr add fd00::2/127 dev gre-b-2
ExecStart=/sbin/ip link set dev gre-b-2 mtu 1472
ExecStart=/sbin/ip link set dev gre-b-2 txqueuelen 500
ExecStart=/sbin/ip link set dev gre-b-2 up
ExecStop=-/sbin/ip link set dev gre-b-2 down
ExecStop=-/sbin/ip link del gre-b-2

[Install]
WantedBy=multi-user.target
