# gre-panel:managed=1 interface=gre6-a-1
# This file is generated by gre-panel. Edit the tunnel in the panel; changes made
# here are overwritten the next time it is applied.

[Unit]
Description=GRE Tunnel gre6-a-1 (managed by gre-panel)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=-/sbin/modprobe ip6_gre
ExecStartPre=-/sbin/ip link del gre6-a-1
ExecStart=/sbin/ip link add name gre6-a-1 type ip6gre local 2001:db8::1 remote 2001:db8::2 hoplimit 64 tos inherit ikey 7 okey 7
ExecStart=/sbin/ip addr add fd00:1::1/127 dev gre6-a-1
ExecStart=/sbin/ip link set dev gre6-a-1 mtu 1440
ExecStart=/sbin/ip link set dev gre6-a-1 up
ExecStop=-/sbin/ip link set dev gre6-a-1 down
ExecStop=-/sbin/ip link del gre6-a-1

[Install]
WantedBy=multi-user.target
